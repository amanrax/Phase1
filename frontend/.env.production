# Production environment for mobile APK builds
# API will connect to your PC running Docker backend

# Your PC IP address - Backend API URL
VITE_API_BASE_URL=http://192.168.1.66:8000

# Mobile-specific API URL (used when running in Capacitor)
VITE_MOBILE_API_URL=http://192.168.1.66:8000

# Production backend URL (fallback)
VITE_API_PROD_URL=http://192.168.1.66:8000

# App information
VITE_APP_NAME=CEM Farmer
VITE_APP_VERSION=2.0.0
VITE_ENVIRONMENT=production
