{
  "name": "frontend",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:strict": "tsc && vite build",
    "build:mobile": "vite build && npx cap sync",
    "lint": "eslint .",
    "preview": "vite preview",
    "cap:init": "npx cap init",
    "cap:add:android": "npx cap add android",
    "cap:add:ios": "npx cap add ios",
    "cap:sync": "npx cap sync",
    "cap:sync:android": "npx cap sync android",
    "cap:sync:ios": "npx cap sync ios",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "bump-version": "node scripts/bump-version.js",
    "bump-version:patch": "node scripts/bump-version.js patch",
    "bump-version:minor": "node scripts/bump-version.js minor",
    "bump-version:major": "node scripts/bump-version.js major",
    "build:android:debug": "bash scripts/build-android.sh debug",
    "build:android:release": "bash scripts/build-android.sh release",
    "build:ios": "bash scripts/build-ios.sh",
    "build:ios:release": "bash scripts/build-ios.sh Release",
    "release:android": "npm run bump-version:patch && npm run build:android:release",
    "release:ios": "npm run bump-version:patch && npm run build:ios:release",
    "release:all": "npm run bump-version:patch && npm run build:android:release && npm run build:ios:release"
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/app": "^6.0.3",
    "@capacitor/browser": "^6.0.6",
    "@capacitor/core": "^6.0.0",
    "@capacitor/dialog": "^6.0.3",
    "@capacitor/filesystem": "^6.0.4",
    "@capacitor/ios": "^6.0.0",
    "@capacitor/share": "^6.0.4",
    "@fortawesome/fontawesome-free": "^7.1.0",
    "axios": "^1.13.1",
    "jspdf": "^3.0.4",
    "jspdf-autotable": "^5.0.2",
    "localforage": "^1.10.0",
    "lottie-react": "^2.4.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.5",
    "recharts": "^3.7.0",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "@eslint/js": "^9.36.0",
    "@types/node": "^24.10.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.45.0",
    "vite": "^7.1.7"
  }
}
